# Loaded only when APP_ENV=e2e (Playwright's webServer). Keeps browser tests
# off the production database, mailer, queue and Redis. bootstrap/app.php also
# points storage (logs, sessions, uploads) at storage_test/ for this env.
APP_NAME="RETINA E2E"
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8123

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
